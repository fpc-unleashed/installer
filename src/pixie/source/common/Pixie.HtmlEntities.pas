var
  EntityMap: TPixieEntityMap;
  LegacySet: TPixieStringBoolMap;

function PixieLookupEntity(const Name: string; out Data: TPixieEntityData): Boolean;
begin
  Result := EntityMap.TryGetValue(Name, Data);
end;

function PixieIsLegacyEntity(const Name: string): Boolean;
var
  Dummy: Boolean;
begin
  Result := LegacySet.TryGetValue(Name, Dummy);
end;

function PixieDecodeNumericRef(Codepoint: UInt32): UInt32;
begin
  if (Codepoint >= $80) and (Codepoint <= $9F) then
    Result := Win1252Replacements[Codepoint]
  else if (Codepoint = 0) or (Codepoint > $10FFFF) or
          ((Codepoint >= $D800) and (Codepoint <= $DFFF)) then
    Result := $FFFD
  else
    Result := Codepoint;
end;

procedure InitEntities;
var
  I: Integer;
  Data: TPixieEntityData;
begin
  EntityMap := TPixieEntityMap.Create(EntityCount);
  for I := 0 to EntityCount - 1 do
  begin
    Data.Codepoint1 := EntityData[I].CP1;
    Data.Codepoint2 := EntityData[I].CP2;
    EntityMap.Add(EntityData[I].Name, Data);
  end;

  LegacySet := TPixieStringBoolMap.Create(LegacyEntityCount);
  for I := 0 to LegacyEntityCount - 1 do
    LegacySet.Add(LegacyEntityNames[I], True);
end;

initialization
  InitEntities;

finalization
  EntityMap.Free;
  LegacySet.Free;

end.
